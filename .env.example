# DA-MIMAROPA Fleet Management System - environment template
#
# Copy to .env, then run: php artisan key:generate
# Values below are safe production defaults. Never commit the real .env file.
# For local development, set APP_ENV=local, APP_DEBUG=true and SESSION_SECURE_COOKIE=false.

APP_NAME="DA-MIMAROPA"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Must be the public HTTPS address (no trailing slash): uploaded photos, avatars and licence images use it.
APP_URL=https://fleet.example.gov.ph

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Daily log files, kept for 30 days. "warning" avoids filling disks with debug output.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

# Use a dedicated database user with a strong password (not root).
# DB_HOST must match the host part of that MySQL user (see DEPLOYMENT.md).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fleetdb
DB_USERNAME=fleet_app
DB_PASSWORD=

# Sessions are stored in the database. Secure cookies require HTTPS.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# A real mail server is required for "Forgot password" emails.
# With MAIL_MAILER=log the Forgot Password page asks users to contact an administrator instead.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.gov.ph
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.gov.ph"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
